int page = 0;

OnUpdate()
{
    if (IsKeyPressed("J") && IsAlive(0))
    {
        if (page)
        {
            UiClosePanel("entertainment");
            page = 0;
        }
        else
        {
            ShowPage(1);
        }
    }
    if (IsKeyPressed("NUMPAD1") && IsAlive(0))
    {
        CharEquipWeapon(0, 1);
    }
}

Level_OnStop()
{
    UiClosePanel("entertainment");
    page = 0;
}

ShowPage(int next)
{
    UiClosePanel("entertainment");
    page = next;
    UiCreatePanel("entertainment", "娱乐菜单");
    if (page == 1)
    {
        UiAddText("entertainment", "位置存档 · 1 / 3");
        UiAddImage("entertainment", "Image/PstUi/menu.png");
        UiAddButton("entertainment", "save", "保存当前位置");
        UiAddButton("entertainment", "load", "返回存档位置");
        UiAddButton("entertainment", "actors", "角色操作 →");
    }
    if (page == 2)
    {
        UiAddText("entertainment", "角色操作 · 2 / 3");
        UiAddButton("entertainment", "weapon", "装备剑");
        UiAddButton("entertainment", "npc", "召唤练习守卫");
        UiAddButton("entertainment", "items", "道具与声音 →");
    }
    if (page == 3)
    {
        UiAddText("entertainment", "道具与声音 · 3 / 3");
        UiAddButton("entertainment", "item", "抛出灵芝");
        UiAddButton("entertainment", "sound", "播放提示音");
        UiAddButton("entertainment", "position", "← 位置存档");
    }
    UiAddButton("entertainment", "close", "关闭");
    UiShowPanel("entertainment");
}

OnUiButton(string panel, string button)
{
    if (panel != "entertainment")
    {
        return;
    }
    if (button == "actors") { ShowPage(2); return; }
    if (button == "items") { ShowPage(3); return; }
    if (button == "position") { ShowPage(1); return; }
    if (button == "save")
    {
        if (SaveVector("demo_" + GetSceneScriptName(), CharGetPosition(0)))
        {
            PrintSystemText("已保存当前位置");
        }
    }
    if (button == "load")
    {
        if (CharSetPosition(0, LoadVector("demo_" + GetSceneScriptName())))
        {
            PrintSystemText("已返回存档位置");
        }
    }
    if (button == "weapon") { CharEquipWeapon(0, 6); }
    if (button == "npc") { ExecuteFunction("mission", "SpawnPracticeGuard"); }
    if (button == "item") { CharDropTempItem(0, 2, 2); }
    if (button == "sound")
    {
        SoundPlay("hint", "Image/PstUi/hint.wav");
        SoundBindActor("hint", 0);
    }
    UiClosePanel("entertainment");
    page = 0;
}
